rules_version = '2';
// Only lets the Storage emulator start. storage.test.js loads the real rules
// (../storage.rules or STORAGE_RULES_FILE) through @firebase/rules-unit-testing.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
