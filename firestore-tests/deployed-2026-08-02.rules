rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ==============================
       Helper Functions
    ============================== */

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUploader(data) {
      return isAuthenticated() && data.userId == request.auth.uid;
    }

    function isEventOwner(eventId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && (
          get(/databases/$(database)/documents/events/$(eventId)).data.adminId == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid
        );
    }

    function validTimestamp(v) {
      return v is timestamp;
    }

function validMediaDoc(data) {
  return data.keys().hasAll([
    'eventId',
    'url',
    'userId',
    'filename',
    'createdAt'
  ])
  && data.eventId is string
  && data.url is string
  && data.userId is string
  && data.filename is string
  && data.createdAt is timestamp
  && (
    !('status' in data) ||
    data.status in ['processing', 'ready']
  );
}


    function validGuestbookEntry(data) {
      return data.keys().hasAll([
        'eventId',
        'userId',
        'displayName',
        'type',
        'createdAt'
      ])
      && data.eventId is string
      && data.userId is string
      && data.displayName is string
      && data.type in ['text', 'video']
      && validTimestamp(data.createdAt);
    }

    /* ==============================
       Events
    ============================== */

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isEventOwner(eventId);
    }

    /* ==============================
       Gallery (Photos)
    ============================== */

    match /gallery/{docId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && isUploader(request.resource.data)
        && validMediaDoc(request.resource.data);

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isEventOwner(resource.data.eventId)
      );
    }

    /* ==============================
       Videos
    ============================== */

    match /videos/{docId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && isUploader(request.resource.data)
        && validMediaDoc(request.resource.data);

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isEventOwner(resource.data.eventId)
      );
    }

    /* ==============================
       Guestbook
    ============================== */

   match /guestbook/{docId} {
  allow read: if true;

  allow create: if isAuthenticated()
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.eventId is string
    && request.resource.data.displayName is string
    && request.resource.data.type in ['text', 'image', 'video']
    && (
      request.resource.data.createdAt is timestamp ||
      request.resource.data.createdAt == request.time
    );

  allow update: if isAuthenticated()
    && (
      resource.data.userId == request.auth.uid ||
      isEventOwner(resource.data.eventId)
    );

  allow delete: if isAuthenticated()
    && (
      resource.data.userId == request.auth.uid ||
      isEventOwner(resource.data.eventId)
    );
}

    

    /* ==============================
       Stripe / Customers
    ============================== */

    match /customers/{uid} {
      allow read: if request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }

      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }

      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
        /* ✅ ACTIVATE DEMO */
  match /purchases/{purchaseId} {
    allow read, create: if request.auth.uid == uid;
  }
    }

    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }

      match /tax_rates/{id} {
        allow read: if true;
      }
    }
/* ==============================
   Users
============================== */

match /users/{uid} {
  allow read: if request.auth != null && request.auth.uid == uid;
  allow create, update: if request.auth != null && request.auth.uid == uid;
}
/* ==============================
   Guests
============================== */

match /guests/{guestId} {
  allow create, read, update: if request.auth != null
    && request.auth.uid == guestId;
}
/* ==============================
   Coupons
============================== */

match /coupons/{couponId} {
  // Anyone can validate and view coupons
  allow read: if true;

  // Only authenticated users can manage coupons
  allow create: if isAuthenticated();
  allow update: if isAuthenticated();
  allow delete: if isAuthenticated();
}

match /affiliates/{id} {
  allow read: if true;            // public: pricing page needs to look up codes
  allow write: if request.auth != null;   // admin-only: create/edit affiliates
}
match /affiliateSales/{id} {
  allow read, write: if request.auth != null;   // customer must be signed in to complete checkout; admin reads the ledger
}
match /payouts/{id} {
  allow read, write: if request.auth != null;   // admin only
}
  /* ==============================
   Fallback (READ ONLY)
============================== */

match /{document=**} {
  allow read: if isAuthenticated();
}
  }
}
